{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true
  },
  "include": ["*.mjs"],
  "exclude": ["node_modules", "dist", "__tests__"]
}
